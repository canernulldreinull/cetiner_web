# Örnek ortam değişkenleri. Gerçek değerleri buraya yazmayın;
# canlıda Vercel → Project Settings → Environment Variables kullanılır.

# api/send-mail.js — Resend API anahtarı (zorunlu)
RESEND_API_KEY=

# api/send-mail.js — virgülle ayrılmış ek izinli kaynaklar (opsiyonel)
# Örnek: https://onizleme.example.com
ALLOWED_ORIGINS=
